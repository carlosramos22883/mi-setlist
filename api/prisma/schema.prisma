// Prisma 7: el cliente se genera en src/generated/prisma
// y se importa desde ahí (adiós @prisma/client mágico)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // La URL vive en prisma.config.ts (estilo Prisma 7)
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  avatarPath      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft delete: null = activo

  // Tokens y RBAC
  refreshTokens       RefreshToken[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  roles               UserRole[]
  createdSongs        Song[]                   @relation("SongCreator")
  createdSetlists     Setlist[]                @relation("SetlistCreator")

  // Grupos: UNA relación por modelo, cada una con su par claro
  ownedGroups      Group[]           @relation("GroupOwner")
  groupMemberships GroupMember[]
  sentInvitations  GroupInvitation[]
  groups           Group[]
  songs            Song[]
  setlists         Setlist[]
  songNotes        SongNote[]        @relation("SongNotes")
  favoriteSongs    FavoriteSong[]    @relation("FavoriteSongs")

  @@map("users")
}

// -----------------------------------------------
// REFRESH TOKENS
// -----------------------------------------------
// Guardamos el token HASHEADO (no en texto plano):
// si alguien roba la base de datos, no podrá usarlos.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique // sha256 del token real
  userId    String // de quién es
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // cuándo muere
  revokedAt DateTime? // si se revocó (logout/rotación), cuándo fue
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
}

// -----------------------------------------------
// TOKENS DE VERIFICACIÓN DE CORREO
// -----------------------------------------------
// El link del correo contiene el token "crudo";
// en la BD guardamos su hash, con expiración de 24h y un solo uso.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime? // null = aún no se usó
  createdAt DateTime  @default(now())

  @@map("email_verification_tokens")
}

// -----------------------------------------------
// TOKENS DE RECUPERACIÓN DE CONTRASEÑA
// -----------------------------------------------
// Igual que los de verificación: hash en BD, 1 hora de vida, un solo uso.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// -----------------------------------------------
// RBAC (Role-Based Access Control) — estilo Spatie
// -----------------------------------------------
model Role {
  id          String   @id @default(uuid())
  name        String   @unique // "Administrador", "Usuario"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // "users.create", "roles.edit"...
  group       String // "users", "roles" (para agrupar en la UI)
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

// Tabla pivote: usuarios ↔ roles (muchos a muchos)
model UserRole {
  roleId    String
  userId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

// Tabla pivote: roles ↔ permisos (muchos a muchos)
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------
// GRUPOS MUSICALES (coros, bandas, orquestas...)
// -----------------------------------------------
model Group {
  id          String    @id @default(uuid())
  name        String
  description String?
  type        GroupType @default(band)
  logoPath    String? // ruta relativa en storage ("uploads/xxx.png")
  ownerId     String
  owner       User      @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  members     GroupMember[]
  invitations GroupInvitation[]
  user        User?             @relation(fields: [userId], references: [id])
  userId      String?
  songs       Song[]
  setlists    Setlist[]
  categories  SongCategory[]

  @@map("groups")
}

enum GroupType {
  band // Banda
  choir // Coro
  orchestra // Orquesta
  vocal_group // Grupo vocal
  other // Otro
}

// -----------------------------------------------
// MIEMBROS DE GRUPO (roles internos, distintos al RBAC global)
// -----------------------------------------------
model GroupMember {
  id       String     @id @default(uuid())
  groupId  String
  userId   String
  role     MemberRole @default(member)
  joinedAt DateTime   @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId]) // un usuario = una membresía por grupo
  @@map("group_members")
}

enum MemberRole {
  owner // Dueño del grupo (uno solo)
  admin // Administrador del grupo
  member // Miembro regular
}

// -----------------------------------------------
// INVITACIONES A GRUPOS
// -----------------------------------------------
model GroupInvitation {
  id          String           @id @default(uuid())
  groupId     String
  email       String // correo del invitado
  token       String           @unique // para aceptar vía enlace
  role        MemberRole       @default(member)
  invitedById String
  invitedBy   User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  status      InvitationStatus @default(pending)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("group_invitations")
}

enum InvitationStatus {
  pending
  accepted
  declined
  expired
}

// -----------------------------------------------
// CANCIONES (repertorio de un grupo)
// -----------------------------------------------
model Song {
  id              String    @id @default(uuid())
  groupId         String
  title           String
  artist          String?
  author          String?
  lyrics          String    @default("")
  chordsData      Json? // estructura de acordes (para más adelante)
  songKey         String?   @map("key") // tonalidad (G, Am, C...)
  bpm             Int?
  durationSeconds Int?
  language        String?
  genre           String?
  coverPath       String? // ruta relativa en storage
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft delete

  group      Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy  User               @relation("SongCreator", fields: [createdById], references: [id], onDelete: Restrict)
  setlists   SetlistSong[]
  user       User?              @relation(fields: [userId], references: [id])
  userId     String?
  categories SongCategoryItem[]
  notes      SongNote[]
  favorites  FavoriteSong[]

  @@map("songs")
}

// -----------------------------------------------
// SETLISTS (repertorios ordenados)
// -----------------------------------------------
model Setlist {
  id          String    @id @default(uuid())
  groupId     String
  name        String
  description String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User          @relation("SetlistCreator", fields: [createdById], references: [id], onDelete: Restrict)
  songs     SetlistSong[]
  user      User?         @relation(fields: [userId], references: [id])
  userId    String?

  @@map("setlists")
}

// -----------------------------------------------
// PIVOTE: setlist ↔ canción (muchos a muchos + orden)
// -----------------------------------------------
model SetlistSong {
  id        String  @id @default(uuid())
  setlistId String
  songId    String
  position  Int // orden dentro del setlist
  customKey String? // tonalidad específica para ESTE setlist
  notes     String? // notas específicas para ESTE setlist

  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  song    Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([setlistId, songId]) // una canción = una vez por setlist
  @@map("setlist_songs")
}

// -----------------------------------------------
// CATEGORÍAS DE CANCIONES (por grupo)
// -----------------------------------------------
model SongCategory {
  id        String   @id @default(uuid())
  groupId   String
  name      String
  color     String? // hex opcional para chips de color
  createdAt DateTime @default(now())

  group Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  songs SongCategoryItem[]

  @@unique([groupId, name]) // nombres únicos por grupo
  @@map("song_categories")
}

// Pivote explícito: canción ↔ categoría (muchos a muchos)
model SongCategoryItem {
  songId     String
  categoryId String

  song     Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  category SongCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([songId, categoryId])
  @@map("song_category_items")
}

// -----------------------------------------------
// NOTAS PERSONALES POR MÚSICO (privadas)
// -----------------------------------------------
model SongNote {
  id        String   @id @default(uuid())
  songId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation("SongNotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([songId, userId]) // una nota por músico por canción
  @@map("song_notes")
}

// -----------------------------------------------
// FAVORITAS (por usuario)
// -----------------------------------------------
model FavoriteSong {
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation("FavoriteSongs", fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@map("favorite_songs")
}
