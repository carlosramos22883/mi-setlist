# ============================================
# MI SETLIST - API (desarrollo local)
# ============================================
# Es el "gemelo público" del .env: MISMA estructura, y este SÍ se sube a GitHub.
# Sirve de plantilla: quien clone el proyecto lo copia con
#   cp .env.example .env
# y completa sus propios valores.

# App
NODE_ENV=development
PORT=3000

# Base de datos
# OJO: puerto 5434
DATABASE_URL="postgresql://misetlist:misetlist_secret@localhost:5434/misetlist?schema=public"

# JWT (en producción: secretos largos generados al azar)
JWT_ACCESS_SECRET=dev-access-secret-cambiar
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-cambiar
JWT_REFRESH_EXPIRES_IN=7d

# Correo (Mailpit del proyecto: puerto 1026)
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM="Mi SetList <no-reply@misetlist.app>"

# URLs
API_URL=http://localhost:3000
WEB_URL=http://localhost:8082